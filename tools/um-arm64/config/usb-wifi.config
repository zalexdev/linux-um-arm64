# Kernel symbols for passing a USB WiFi adapter into the guest.
#
# Apply on top of the ordinary defconfig, out of tree:
#
#	make -C linux O=$O ARCH=um SUBARCH=arm64 LLVM=1 defconfig
#	cat config/usb-wifi.config >> $O/.config
#	make -C linux O=$O ARCH=um SUBARCH=arm64 LLVM=1 olddefconfig
#
# The thirteen lines below become 92 new symbols after olddefconfig -- crypto
# for mac80211, the RTW88_CORE/88XXA/8821A chain, USB_COMMON, SGL_ALLOC and so
# on all arrive by select or by default, so none of them is repeated here. The
# only symbols that go *away* are NO_IOMEM and NO_DMA, which is the point of
# the first group.
#
# Everything is =y because this kernel has no module support (CONFIG_MODULES is
# not set in the UML defconfig, and the guest image has no modutils): a driver
# that is not built in does not exist.

# usbcore depends on HAS_IOMEM and HAS_DMA, and that is the whole reason these
# two are here -- vhci-hcd itself contains neither MMIO nor DMA; its "bus" is a
# socket. Before 7a70d4a6f both emulations were hidden symbols that only
# UML_PCI selected, so reaching usbcore meant enabling a PCI bus that then warns
# at boot with "No virtio device ID configured for PCI - no PCI support" and a
# stack trace. Selecting UML_IOMEM_EMULATION also clears NO_IOMEM, which depends
# on !INDIRECT_IOMEM.
CONFIG_UML_IOMEM_EMULATION=y
CONFIG_UML_DMA_EMULATION=y

# The USB stack and the virtual host controller the adapter arrives through.
# vhci-hcd takes a SOCK_STREAM socket written into
# /sys/devices/platform/vhci_hcd.0/attach and presents whatever is on the other
# end as a device on its root hub; the other end here is umusb on the Android
# side, driving the real adapter through the usbfs descriptor the permission
# dialog handed the app.
#
# USBIP_HOST -- the export direction -- is deliberately not enabled: the guest
# has no real USB device of its own to share, and vhci-hcd is the only half of
# USB/IP this design uses.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USBIP_CORE=y
CONFIG_USBIP_VHCI_HCD=y

# The wireless stack, and the driver for the adapter in hand: a Realtek
# RTL8811AU (USB 2357:011f). rtw88's 8821au front end covers both parts -- its
# Kconfig prompt says "8821AU/8811AU" and 2357:011f is in rtw_8821au_id_table --
# and they share rtw8821a_hw_spec. The interface descriptor is
# class/subclass/protocol 0xff, so the match is by USB_DEVICE_AND_INTERFACE_INFO
# and nothing generic will bind it by accident.
#
# RTW88_USB, RTW88_CORE, RTW88_8821A and RTW88_88XXA are all reached by select
# from RTW88_8821AU. WLAN and WLAN_VENDOR_REALTEK are already y in defconfig and
# are listed only so this fragment stands on its own.
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTW88=y
CONFIG_RTW88_USB=y
CONFIG_RTW88_8821AU=y

# Not enabled here, but the first two things to turn on when an attach
# misbehaves: USBIP_DEBUG, which makes vhci log every URB, and RTW88_DEBUG,
# which turns on rtw_dbg() so the firmware handshake is visible. Both are pure
# noise once the link works, which is why they are left off. (Written without a
# leading "CONFIG_" on purpose: merge_config.sh reads any commented line
# beginning with that prefix as a symbol assignment.)
