# 16 KB guest pages.
#
# A guest page is a host mmap(), so it can never be smaller than the host's
# page size, and every Android 15+ device ships a 16 KB host kernel. A 4 KB
# build refuses to run there -- correctly, in os_early_checks() -- so a binary
# meant to run on modern phones has to be built this way.
#
# It costs nothing on a 4 KB host: one guest page is simply four host pages.
# That is what makes a single 16 KB binary enough for both.
CONFIG_PAGE_SIZE_16KB=y
