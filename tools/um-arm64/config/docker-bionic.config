# Docker on the bionic build, minus BPF.
#
# CONFIG_BPF_SYSCALL does not compile against bionic here, and the reason is
# this port's own doing rather than anything in BPF: arch/arm64/Makefile.um
# renames a handful of libc names with -D so that bionic's own calls do not
# bind to the kernel's definitions, and "snprintf" is not only a function name
# but a bare token in __BPF_FUNC_MAPPER. The rename rewrites it there too, so
# kernel/bpf/disasm.c asks for BPF_FUNC_kernel_snprintf, which does not exist.
#
# The real fix is to rename at the object level (objcopy --redefine-sym) rather
# than in the preprocessor, where it cannot touch identifiers being assembled by
# token pasting. Until then this file is docker.config without CGROUP_BPF, which
# costs the device controller on cgroup v2 -- docker starts and runs; per
# container device rules are not enforced.
CONFIG_BPF_SYSCALL=n
CONFIG_CGROUP_BPF=n
